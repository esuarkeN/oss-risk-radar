# LaTeX build output. build/thesis.pdf (scripts/build.ps1) is tracked and contains no
# signature. The submission build (scripts/build.ps1 -Submission) binds in the signed
# Steckbrief and is never tracked, because this repository is public.
tex/thesis/build/*
!tex/thesis/build/thesis.pdf
tex/thesis/build/thesis-submission.pdf
tex/thesis/thesis.pdf
tex/thesis/**/*.aux
tex/thesis/**/*.bbl
tex/thesis/**/*.bcf
tex/thesis/**/*.blg
tex/thesis/**/*.fdb_latexmk
tex/thesis/**/*.fls
tex/thesis/**/*.glg
tex/thesis/**/*.glo
tex/thesis/**/*.gls
tex/thesis/**/*.ist
tex/thesis/**/*.lof
tex/thesis/**/*.log
tex/thesis/**/*.lot
tex/thesis/**/*.out
tex/thesis/**/*.run.xml
tex/thesis/**/*.synctex.gz
tex/thesis/**/*.toc

# Signed Telekom Steckbrief bound into the thesis front matter. Carries a personal
# signature; this repository is public, so the file stays local. main.tex guards the
# \includepdf so the thesis still builds without it.
tex/thesis/frontmatter/steckbrief.pdf

# Personal data for the handed-in version (matriculation number, e-mail, study group,
# examiners, signing city). Read only by scripts/build.ps1 -Submission; the tracked
# metadata.tex carries the redacted defaults, so the public build works without it.
tex/thesis/metadata-private.tex

# Scanned handwritten signature for the declaration of authorship. Bound in by
# scripts/build.ps1 -Submission only; the public build leaves the rule empty.
tex/thesis/frontmatter/signature.png
